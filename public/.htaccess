# Apache configuration for Media Optimizer
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o carpeta existe físicamente en public/, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # De lo contrario, redirigir todas las peticiones a index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Prevenir listado de directorios
Options -Indexes

# Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "(^\.|\.env|composer\.(json|lock)|Dockerfile|Caddyfile|README\.md|HISTORIA\.md|SECURITY\.md)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
